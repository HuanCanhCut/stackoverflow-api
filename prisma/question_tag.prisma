model QuestionTag {
  question_id Int
  tag_id      Int

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag      Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([question_id, tag_id])
  @@map("question_tags")
}
